parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        - identifier: property.unusedType
          path: src/Model/Entity
        - identifier: property.onlyRead
          path: src/Model/Entity
        - identifier: property.onlyWritten
          path: src/Model/Entity/VideoGame.php
